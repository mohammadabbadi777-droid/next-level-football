# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_level_football
DB_HOST=localhost
DB_PORT=5432
DB_NAME=next_level_football
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Redis
REDIS_URL=redis://localhost:6379

# Cors
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug